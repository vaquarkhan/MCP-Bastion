# MCP-Bastion dashboard (FastAPI). Requires mcp-bastion-python: dashboard imports metrics,
# audit hash chain, and policy_simulator (same dependency graph as the library).
# Build: docker build -f Dockerfile.dashboard -t mcp-bastion/dashboard .
# Run:  docker run -p 7000:7000 mcp-bastion/dashboard
#
# Pin matches main proxy image by default:
#   docker build -f Dockerfile.dashboard --build-arg BASTION_PY_VERSION=1.0.15 -t mcp-bastion/dashboard .

FROM python:3.11-slim

WORKDIR /app

ARG BASTION_PY_VERSION=1.0.15

RUN python -m pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir "mcp-bastion-python==${BASTION_PY_VERSION}" "fastapi>=0.100.0" "uvicorn>=0.22.0"

COPY dashboard /app/dashboard
COPY images /app/images

ENV PYTHONUNBUFFERED=1

LABEL org.opencontainers.image.title="MCP-Bastion dashboard" \
      org.opencontainers.image.description="Metrics and forensics UI for MCP-Bastion"

EXPOSE 7000

CMD ["python", "/app/dashboard/app.py"]
