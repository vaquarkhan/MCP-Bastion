# MCP-Bastion policy-as-code (single config file)
# Copy to bastion.yaml and customize. Load via load_config() or env BASTION_CONFIG.
#
# Red-team / harness note: a low "block %" often means pillars were intentionally disabled
# (e.g. no prompt guard model). See docs/REDTEAM.md for what to enable to tighten posture.

prompt_guard:
  enabled: true
  threshold: 0.85
  heuristic_fallback: true   # blocks obvious jailbreaks without ML (always on by default)
  fail_open: false         # when ML unavailable: block unverified payloads (dev: set true)
  # Default: ungated ProtectAI model (no Hugging Face login). Works out of the box with transformers+torch.
  use_ungated_default: true
  # N-2: require injection-intent markers before trusting ML "malicious" (suppresses business-verb FPs).
  # Set require_ml_corroboration: false for max-recall (higher FP) deployments.
  require_ml_corroboration: true
  # ml_corroboration_ceiling: 1.01  # ProtectAI is uncalibrated; leave default (ceiling effectively off)
  # Optional gated Llama model: set use_ungated_default: false and model_id below, then `huggingface-cli login`
  # model_id: meta-llama/Llama-Prompt-Guard-2-86M

pii:
  enabled: true

# Reversible tokenization (opt-in). Default OFF - destructive Presidio placeholders remain.
# When enabled: outbound results use {{pii:TYPE:id}}; inbound tool args are hydrated before the MCP server.
# HTTP proxy also abstracts upstream results and hydrates tools/call args on the wire.
# See docs/PII_VAULT.md
pii_vault:
  enabled: false
  ttl_seconds: 3600
  # token_style: typed        # default
  # token_style: low_entropy  # EMAIL_ADDRESS_1 / Person_A

rate_limit:
  enabled: true
  max_iterations: 15
  timeout_seconds: 60
  token_budget: 50000
  max_per_tool: 0   # set e.g. 50 for per-tool session caps (denial-of-wallet)

response_scan:
  enabled: true     # block jailbreak patterns in outbound tool/resource text
  extra_patterns: []
  # use_prompt_guard: false  # optional: reuse inbound PromptGuard ML on tool outputs

# Toxic-flow taint: PII/secret on a prior result → later egress tool with URL/email args.
toxic_flow:
  enabled: false
  on_violation: block   # block | warn

discovery_filter:
  enabled: false    # strip non-allowlisted tools from tools/list (requires tool_allowlist)
  # Context engineering (opt-in): shrink verbose tool manifests without removing tools.
  minimize_schemas: false
  max_description_chars: 160
  strip_schema_descriptions: true

# FinOps: truncate/offload large tool outputs (opt-in).
output_budget:
  enabled: false
  max_output_tokens: 4000
  min_tokens: 500
  max_response_bytes: 0    # e.g. 524288 (512 KiB) to block context-flooding payloads
  offload: true
  retrieve_tool: bastion_get_offloaded

# Security: verify file paths in tool output (opt-in).
grounding_guard:
  enabled: false
  workspace_root: .
  on_violation: warn   # warn | block | strip

# Safer defaults: block risky patterns in tool arguments (paths, code-ish payloads).
circuit_breaker:
  enabled: true

content_filter:
  enabled: true
  # Defaults ON with scoped patterns: shell/exfil (curl|bash, rm -rf) and sensitive
  # paths (/etc/passwd, ../). Discussing eval() / markdown fences is allowed.
  block_code_execution: true
  block_file_paths: true
  block_urls: false
  # High-confidence secrets (AKIA…, sk-…, ghp_…) — library default is on.
  block_secrets: true
  allowlist_patterns: []
  denylist_patterns: []

# Tighten further when you define roles and tool lists (off until you wire identities).
rbac:
  enabled: false
  require_authenticated_identity: true   # default; pair with agent_iam or edge_auth
  permissions:
    default: ["*"]
    analyst: ["read_data", "query"]
    admin: ["*"]

# Enable when you attach JSON schemas to tools (see schema_validation.schemas).
# strict: reject unexpected args; mark optional fields with `type?` or required: false.
schema_validation:
  enabled: false
  strict: false
  schemas:
    create_report:
      year: integer
      amount: number
    submit_form:
      email: string
      nickname: string?   # optional

replay_guard:
  enabled: true
  require_nonce: false

cost_tracker:
  enabled: false
  max_cost_per_session: 0.50
  max_cost_per_day: 10.0
  # Optional disk checkpoint for session/daily totals (memory backend only).
  checkpoint_path: .bastion/cost-checkpoint.json

# Cost-aware policy: degrade/route/block using live spend (requires cost_tracker).
cost_policy:
  enabled: false
  rules:
    - when: { session_spend_pct_gte: 80 }
      action: degrade_model
      target_model: gpt-4o-mini
    - when: { session_spend_pct_gte: 90 }
      action: force_discovery_filter
    - when: { session_spend_pct_gte: 95 }
      action: require_approval
  expensive_chain:
    enabled: false
    max_projected_cost_usd: 1.0
    default_tool_cost_usd: 0.05
    tool_costs:
      expensive_api: 0.50
  approval_metadata_key: bastion_cost_approval

# Mandatory proxy boundary - requires edge_auth or agent_iam (see docs/GATEWAY_BOUNDARY.md).
boundary_mode:
  enabled: false

# BYOI: consume gateway-stamped identity (no login server). See docs/ZERO_INFRA_STRATEGY.md.
identity_adapter:
  enabled: false
  type: header              # header | jwt_claim
  header: X-Bastion-Principal
  role_header: X-Bastion-Role
  jwt_metadata_key: bastion_jwt
  principal_claim: sub
  role_claim: scope
  # Optional crypto verify (still BYOI — no OAuth login server):
  # verify: true
  # issuer: https://idp.example
  # audience: mcp-bastion
  # jwks_url: https://idp.example/.well-known/jwks.json
  # hmac_secret_env: BASTION_JWT_HMAC_SECRET   # HS256 without PyJWT
  # scope_map:
  #   tools:read: analyst
  #   tools:admin: admin

# BYO vault for secret refs (default: env). See pillars/secrets_resolver.py.
secrets:
  provider: env

argument_guards:
  enabled: false
  rules:
    - name: block_shell_injection
      match: "*"
      arg: "$.command"
      pattern: "(rm\\s+-rf|curl\\s+.*\\|.*sh)"
      action: block
    - name: redact_api_keys
      match: "*"
      arg: "$..*"
      pattern: "(sk-[A-Za-z0-9]{20,})"
      action: redact

semantic_cache:
  enabled: false

audit:
  enabled: true
  # Append-only JSONL for compliance; tail with: mcp-bastion tail --path audit.jsonl
  jsonl_path: .bastion/audit.jsonl

# Local metrics UI (mcp-bastion dashboard). Default is live/empty — not synthetic tour data.
# Env MCP_BASTION_DEMO / MCP_BASTION_DEMO_LIVE override these when set. UI toggle also switches at runtime.
dashboard:
  demo: false                 # true = seed simulated traffic scenarios on startup
  demo_live_traffic: false    # true = background simulator (only when demo is on)

alerts:
  slack_webhook: ${SLACK_WEBHOOK_URL}
  webhook_url: ${BASTION_WEBHOOK_URL}
  webhooks: []
  retry_attempts: 3
  retry_backoff_seconds: 0.25
  retry_backoff_max_seconds: 2.0
  timeout_seconds: 5.0
  alert_on:
    - injection
    - rate_limit
    - cost

# Reload policy when bastion.yaml changes (uses build_middleware_from_config()).
hot_reload:
  enabled: true
  poll_seconds: 2.0

# --- Production hardening (opt-in) ---

# Zero-Trust: Agent Identity & Access Management (Confused Deputy)
agent_iam:
  enabled: false
  token_metadata_key: bastion_agent_token
  require_token: true
  isolate_sessions: true
  agents:
    - id: customer_support_bot
      token_env: BASTION_TOKEN_SUPPORT
      allowed_tools: ["search_docs", "get_ticket_status"]
      blocked_tools: ["execute_sql", "delete_user"]
      rate_limit:
        max_iterations: 5

# Supply chain: verify MCP server file checksums before tool traffic
server_verification:
  enabled: false
  on_mismatch: block
  base_path: .
  manifest_path: mcp-server.manifest.json
  signature_env: BASTION_MANIFEST_SIGNING_KEY

# Localhost CSRF / DNS rebind mitigation for HTTP MCP
transport_hardening:
  enabled: true
  allowed_hosts: ["127.0.0.1", "localhost", "[::1]"]
  block_browser_origin: true
  require_loopback: true

# stdio transport: drop non-JSON lines on stdout
stdio_guard:
  enabled: false

# Semantic schema drift detection (tools/list metadata fingerprint)
# Doctor/CLI: fingerprint_path + expected. Runtime live pin: pin_on_first_seen or expected/path.
tool_metadata_fingerprint:
  enabled: false
  fingerprint_path: tools.fingerprint.json
  # pin_on_first_seen: true   # hash catalog on first tools/list; compare later
  # on_drift: warn            # warn | block
  # pin_ttl_seconds: 604800

governance:
  attestation_enabled: true   # per-session events for mcp-bastion attest export
  allowed_registry_names: ["io.github.vaquarkhan/mcp-bastion"]
  allowed_repository_urls: ["https://github.com/vaquarkhan/MCP-Bastion"]

edge_auth:
  enabled: false
  metadata_key: bastion_edge_token
  secret_env: BASTION_EDGE_SECRET

tool_allowlist:
  enabled: false
  tools: []

tool_metadata_guard:
  enabled: false
  on_poison: remove_tool   # remove_tool | block_all
  use_content_filter: true
  # Requires content_filter or prompt_guard enabled; otherwise this pillar no-ops.

# Cap distinct tools per session (opt-in denial-of-wallet / tool sprawl control).
session_limits:
  max_unique_tools_per_session: 0   # e.g. 5 to limit tool sprawl per session

# External policy: OPA or Cedar CLI (not HTTP). fail_closed: true denies when engine unavailable.
policy_engine:
  type: none   # none | opa | cedar
  fail_closed: true   # default for type != none; deny when OPA/Cedar unavailable
  opa:
    binary: opa
    policy_dir: ./policies/opa   # directory passed to `opa eval -d`
    query: data.bastion.allow
  cedar:
    binary: cedar
    policies_dir: ./policies/cedar   # directory of *.cedar files (CLI needs a file; Bastion concatenates)
    entities: ./policies/cedar/entities.json   # optional; request User/Action/Tool entities are merged in
    schema: ./policies/cedar/schema.cedarschema   # optional
    # Authz maps MCP calls to: principal User::"<session_id>", action Action::"invoke",
    # resource Tool::"<tool_name>" via `cedar authorize --entities ...`.

# Hybrid stateful / stateless MCP transport (opt-in; default OFF).
# Prepares for stateless MCP (SEP-2575) while preserving legacy session-based clients.
# See docs/HYBRID_MCP_TRANSPORT.md
mcp_transport:
  enabled: false
  mode: auto   # auto | stateful | stateless
  state_handle:
    param_names: [state_handle, mcp_state_handle, stateHandle, mcpStateHandle]
    header_names: [mcp-state-handle, x-mcp-state-handle]
    required_in_stateless: false
    min_length: 16
  protocol:
    enabled: false
    header: MCP-Protocol-Version
    allowed_versions: ["2024-11-05", "2025-03-26"]
    default_version: "2024-11-05"
  discovery:
    enabled: false   # HTTP proxy only: GET /.well-known/mcp.json
    card:
      name: mcp-bastion-protected
      version: "1.0.0"
  stability:
    enabled: false
    window_size: 5
    repeat_threshold: 3
    similarity_threshold: 0.92
    on_detect: inject   # inject | block | warn

# Per-agent behavioral fingerprinting (learn tool baselines; warn or block on drift).
# Opt-in middleware pillar (default OFF). audit_metrics stays on for dashboard anomalies.
behavior_fingerprint:
  enabled: false
  audit_metrics: true
  learn_min_calls: 12
  freeze_after_calls: 18
  drift_window: 10
  tool_overlap_threshold: 0.25
  rate_spike_multiplier: 10.0
  on_detect: warn   # warn | block

# Horizontal scaling: share rate limits, replay nonces, cost budgets, and session scope
# across workers/replicas (requires pip install mcp-bastion-python[redis]).
state_backend:
  type: memory   # memory | redis
  redis_url: redis://127.0.0.1:6379/0
  key_prefix: mcp-bastion

# Runtime governance pillars (3.0+). All opt-in.
mode: enforce   # enforce | observe (observe logs would-block without denying)

canary_goallock:
  enabled: false
  token_prefix: BASTION-CANARY-
  rotate_on_detection: true

atr_rules:
  enabled: false
  rules_dir: ./atr-rules
  min_severity: medium

llm_scanner:
  enabled: false
  url: http://localhost:11434
  model: llama3.2:3b
  confidence_threshold: 0.85
  timeout_ms: 2500
  only_when_heuristics_uncertain: true

threat_feeds:
  enabled: false
  feeds: []
  # - url: https://example.com/rules.json
  #   scanner: prompt_injection   # or content_filter
  #   interval_minutes: 60

auto_repave:
  enabled: false
  triggers:
    window_minutes: 5
    canary_detections: 3
  actions:
    rotate_canary: true
    reset_session_scope: false
    kill_sessions: false

secrets:
  redact_patterns: []
  # - rule: "sk-[A-Za-z0-9]{20,}"
  #   strategy: mask   # replace | hash | mask | remove
  #   mask_prefix: 4
  #   mask_suffix: 4
