# MCP-Bastion policy-as-code (single config file)
# Copy to bastion.yaml and customize. Load via load_config() or env BASTION_CONFIG.
#
# Red-team / harness note: a low "block %" often means pillars were intentionally disabled
# (e.g. no prompt guard model). See docs/REDTEAM.md for what to enable to tighten posture.

prompt_guard:
  enabled: true
  threshold: 0.85
  heuristic_fallback: true   # blocks obvious jailbreaks without ML (always on by default)
  fail_open: false         # when ML unavailable: block unverified payloads (dev: set true)
  # Requires Hugging Face access to gated model meta-llama/Llama-Prompt-Guard-2-86M + `huggingface-cli login`

pii:
  enabled: true

rate_limit:
  enabled: true
  max_iterations: 15
  timeout_seconds: 60
  token_budget: 50000
  max_per_tool: 0   # set e.g. 50 for per-tool session caps (denial-of-wallet)

response_scan:
  enabled: true     # block jailbreak patterns in outbound tool/resource text
  extra_patterns: []

discovery_filter:
  enabled: false    # strip non-allowlisted tools from tools/list (requires tool_allowlist)

# FinOps: truncate/offload large tool outputs (opt-in).
output_budget:
  enabled: false
  max_output_tokens: 4000
  min_tokens: 500
  max_response_bytes: 0    # e.g. 524288 (512 KiB) to block context-flooding payloads
  offload: true
  retrieve_tool: bastion_get_offloaded

# Security: verify file paths in tool output (opt-in).
grounding_guard:
  enabled: false
  workspace_root: .
  on_violation: warn   # warn | block | strip

# Safer defaults: block risky patterns in tool arguments (paths, code-ish payloads).
circuit_breaker:
  enabled: true

content_filter:
  enabled: true
  block_code_execution: true
  block_file_paths: true
  block_urls: false
  allowlist_patterns: []
  denylist_patterns: []

# Tighten further when you define roles and tool lists (off until you wire identities).
rbac:
  enabled: false
  permissions:
    default: ["*"]
    analyst: ["read_data", "query"]
    admin: ["*"]

# Enable when you attach JSON schemas to tools.
schema_validation:
  enabled: false

replay_guard:
  enabled: true
  require_nonce: false

cost_tracker:
  enabled: false
  max_cost_per_session: 0.50
  max_cost_per_day: 10.0

semantic_cache:
  enabled: false

audit:
  enabled: true

alerts:
  slack_webhook: ${SLACK_WEBHOOK_URL}
  webhook_url: ${BASTION_WEBHOOK_URL}
  webhooks: []
  retry_attempts: 3
  retry_backoff_seconds: 0.25
  retry_backoff_max_seconds: 2.0
  timeout_seconds: 5.0
  alert_on:
    - injection
    - rate_limit
    - cost

# Reload policy when bastion.yaml changes (uses build_middleware_from_config()).
hot_reload:
  enabled: true
  poll_seconds: 2.0

# --- Production hardening (opt-in) ---

# Zero-Trust: Agent Identity & Access Management (Confused Deputy)
agent_iam:
  enabled: false
  token_metadata_key: bastion_agent_token
  require_token: true
  agents:
    - id: customer_support_bot
      token_env: BASTION_TOKEN_SUPPORT
      allowed_tools: ["search_docs", "get_ticket_status"]
      blocked_tools: ["execute_sql", "delete_user"]
      rate_limit:
        max_iterations: 5

# Supply chain: verify MCP server file checksums before tool traffic
server_verification:
  enabled: false
  on_mismatch: block
  base_path: .
  manifest_path: mcp-server.manifest.json

edge_auth:
  enabled: false
  metadata_key: bastion_edge_token
  secret_env: BASTION_EDGE_SECRET

tool_allowlist:
  enabled: false
  tools: []

tool_metadata_guard:
  enabled: false
  on_poison: remove_tool   # remove_tool | block_all
  use_content_filter: true
