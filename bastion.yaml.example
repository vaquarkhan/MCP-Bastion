# MCP-Bastion policy-as-code (single config file)
# Copy to bastion.yaml and customize. Load via load_config() or env BASTION_CONFIG.

prompt_guard:
  enabled: true

pii:
  enabled: true

rate_limit:
  enabled: true
  max_iterations: 15
  timeout_seconds: 60
  token_budget: 50000

circuit_breaker:
  enabled: false

content_filter:
  enabled: false
  block_code_execution: true
  block_file_paths: true
  block_urls: false
  allowlist_patterns: []
  denylist_patterns: []

rbac:
  enabled: false
  permissions:
    default: ["*"]
    analyst: ["read_data", "query"]
    admin: ["*"]

schema_validation:
  enabled: false

replay_guard:
  enabled: false
  require_nonce: false

cost_tracker:
  enabled: false
  max_cost_per_session: 0.50
  max_cost_per_day: 10.0

semantic_cache:
  enabled: false

audit:
  enabled: true

alerts:
  slack_webhook: ${SLACK_WEBHOOK_URL}
  webhook_url: ${BASTION_WEBHOOK_URL}
  webhooks: []
  retry_attempts: 3
  retry_backoff_seconds: 0.25
  retry_backoff_max_seconds: 2.0
  timeout_seconds: 5.0
  alert_on:
    - injection
    - rate_limit
    - cost

hot_reload:
  enabled: false
  poll_seconds: 2.0
